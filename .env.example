# Existing read-only API proof of concept. Server-only credentials.
EXTERNAL_API_URL=
EXTERNAL_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
# Both URLs must target the approved COCO database, schema=shopify.
DATABASE_URL=
DIRECT_URL=
# Enable on the selected app backend only; published theme remains disabled.
MOCK_CHECKOUT_ENABLED=
MOCK_CHECKOUT_SHOP=
# Optional bearer secret for the protected payment reconciliation scheduler endpoint.
MOCK_PAYMENT_SWEEP_SECRET=
# Server-owned fictional sample product; no Shopify inventory dependency.
MOCK_CHECKOUT_SAMPLE_CATALOG_ENABLED=
# Default simulation: automatic success after 10s, no KBZPay network requests.
# Only simulation or uat. No production mode or automatic fallback.
KBZPAY_MODE=simulation
# Optional release/rollback pause: false blocks new attempts while recovery/callbacks continue.
KBZPAY_ACCEPT_NEW_PAYMENTS=true
# Direct KBZPay UAT merchant credentials (server-only).
KBZPAY_APP_ID=
KBZPAY_MERCH_CODE=
KBZPAY_APP_KEY=
# UAT host/path only. KBZPay documents HTTP for precreate/queryorder;
# use their confirmed HTTPS endpoint when enabled for your merchant/network.
KBZPAY_GATEWAY_BASE_URL=https://api-uat.kbzpay.com/payment/gateway/uat
KBZPAY_PWA_URL=https://static.kbzpay.com/pgw/uat/pwa/#/
# Public HTTPS app-host route; no query parameters or Shopify proxy signature.
KBZPAY_NOTIFY_URL=https://your-app.example/payments/kbzpay/notify
